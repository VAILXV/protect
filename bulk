        label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        label.BackgroundTransparency = 0.35
        label.BorderSizePixel = 0
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 18
        label.Text = "Alt leaves in: waiting…"
        label.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = label

        -- wait for the match to actually start (InGame attribute)
        while true do
            if _G.Stop then
                label.Text = "Alt timer stopped"
                return
            end
            local char = localPlayer.Character
            local court = char and char:GetAttribute("InGame")
            if court and court ~= "" then break end
            task.wait(0.5)
        end

        local startT = tick()
        while true do
            if _G.Stop then
                label.Text = "Alt timer stopped"
                return
            end

            -- if the alt already left, say so and stop counting
            if localPlayer.Name ~= _G.Bot and not Players:FindFirstChild(_G.Bot) then
                label.Text = "Alt left ✔"
                label.TextColor3 = Color3.fromRGB(120, 255, 120)
                return
            end

            local remaining = duration - (tick() - startT)
            if remaining <= 0 then
                label.Text = "Alt leaving now…"
                label.TextColor3 = Color3.fromRGB(255, 170, 60)
                task.wait(1)
            else
                local m = math.floor(remaining / 60)
                local s = math.floor(remaining % 60)
                label.Text = string.format("Alt leaves in: %d:%02d", m, s)
                -- go red in the final 30 seconds
                if remaining <= 30 then
                    label.TextColor3 = Color3.fromRGB(255, 90, 90)
                else
                    label.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
                task.wait(0.25)
            end
        end
    end)

    ------------------------------------------------------------
    -- Scoring helpers (donor script)
    ------------------------------------------------------------

    -- High-precision wait (Heartbeat-based, avoids task.wait jitter on the release)
    local function precise_wait(seconds)
        if not seconds or seconds <= 0 then return end
        local start = os.clock()
        while (os.clock() - start) < seconds do
            RunService.Heartbeat:Wait()
        end
    end

    local function sprint(value)
        actionRemote:FireServer({ Sprinting = value, Type = "Sprint" })
    end

    local function shoot(hold)
        actionRemote:FireServer({ Shoot = true, Type = "Shoot" })
        precise_wait(math.max(0, hold or 0.4))
        actionRemote:FireServer({ Shoot = false, Type = "Shoot" })
    end

    -- Read a shot hold time from _G.Timings (live, so you can edit mid-session)
    local function get_timing(name, fallback)
        local t = _G.Timings
        if type(t) == "table" and tonumber(t[name]) then
            return tonumber(t[name])
        end
        return fallback or 0.4
    end

    local function has_ball(char)
        return char:FindFirstChild("Ball") ~= nil
    end

    local function move_to(char, point)
        if typeof(point) == "Instance" then
            point = point.Position
        end
        char:SetAttribute("MoveToPoint", point)
    end

    local function move_cancel(char)
        char:SetAttribute("MoveToPoint", Vector3.zero)
    end

    -- Wait until within maxDist studs of target (ignoring height), or timeout
    local function wait_until_near(rootPart, target, maxDist, timeout)
        local start = tick()
        while true do
            local p = (typeof(target) == "Instance") and target.Position or target
            local d = (rootPart.Position - Vector3.new(p.X, rootPart.Position.Y, p.Z)).Magnitude
            if d <= (maxDist or 3) then return true end
            if timeout and (tick() - start) >= timeout then return false end
            task.wait()
        end
    end

    -- Tween to a spot `distance` studs out from the goal, facing it
    local function tween_position(rootPart, part, distance)
        local root_position = rootPart.Position
        local part_position = part.Position

        local target_position = Vector3.new(part_position.X, root_position.Y, part_position.Z)
        local backward = -part.CFrame.LookVector
        local target_distance = -backward * distance

        local distance_to_travel = (root_position - target_position).Magnitude
        local time = distance_to_travel / TWEEN_SPEED

        local tween_info = TweenInfo.new(time, Enum.EasingStyle.Linear, Enum.EasingDirection.In)
        local tween = TweenService:Create(rootPart, tween_info, {
            CFrame = CFrame.lookAt(target_position + target_distance, target_position)
        })
        tween:Play()
        tween.Completed:Wait()
    end

    -- Resolve the hoop goal for the court we're playing on
    local function get_goal(char)
        local courtName = char:GetAttribute("InGame")
        if not courtName or courtName == "" then return nil end
        local map = workspace:FindFirstChild("Map")
        local courts = map and map:FindFirstChild("Courts")
        local court = courts and courts:FindFirstChild(courtName)
        local hoop = court and court:FindFirstChild("Hoop2")
        local rim = hoop and hoop:FindFirstChild("Rim")
        return rim and rim:FindFirstChild("Goal")
    end

    ------------------------------------------------------------
    -- Bot Teleport Logic
    ------------------------------------------------------------
    local function botTeleportLogic()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.4)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end

    ------------------------------------------------------------
    -- BOT: E-press when it picks up the ball
    ------------------------------------------------------------
    if localPlayer.Name == _G.Bot then
        task.spawn(function()
            while true do
                task.wait(checkInterval)
                if _G.Stop then
                    print("Script stopped (_G.Stop = true)")
                    break
                end

                local char = localPlayer.Character
                local has = (char and has_ball(char)) or false

                if has and not hasBallLastFrame then
                    print("Bot picked up ball. Running teleport logic.")
                    botTeleportLogic()
                end

                hasBallLastFrame = has
            end
        end)
    end

    ------------------------------------------------------------
    -- MAIN: Scoring loop (donor logic)
    -- Priority if multiple are on: Finishing > Shooting3 > Shooting2
    ------------------------------------------------------------
    if localPlayer.Name == _G.Main then
        task.spawn(function()
            while task.wait() do
                if _G.Stop then
                    print("[SCORING] Stopped (_G.Stop = true)")
                    break
                end

                -- Playmaking mode takes over — skip the shot logic entirely
                if _G.Playmaking then continue end

                local finishing = _G.Finishing
                local is3 = _G.Shooting3
                local is2 = _G.Shooting2
                if not (finishing or is2 or is3) then continue end

                local character = localPlayer.Character
                if not character then continue end
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if not rootPart then continue end

                local goal = get_goal(character)
                if not goal then continue end

                -- No ball: the camera-walk ball chase handles getting one
                if not has_ball(character) then continue end

                -- Already mid-shot: wait
                if character:GetAttribute("Action") == "Shooting" then continue end

                if finishing then
                    -- FINISHING: sprint + hold forward toward the hoop, no pre-steps
                    sprint(true)
                    move_to(character, goal)

                    -- Keep forward held toward the hoop during the approach
                    local conn
                    conn = RunService.RenderStepped:Connect(function()
                        local dir = (goal.Position - rootPart.Position)
                        if dir.Magnitude > 0 then
                            localPlayer:Move(dir.Unit)
                        else
                            localPlayer:Move(Vector3.zero)
                        end
                    end)

                    -- Wait until close enough to register a layup, then shoot while still sprinting
                    wait_until_near(rootPart, goal, 3, 2) -- within ~3 studs or up to 2s
                    shoot(get_timing("Finishing", 0.4))

                    -- Cleanup: release forward, stop sprinting, cancel movement
                    if conn then conn:Disconnect() end
                    localPlayer:Move(Vector3.zero)
                    sprint(false)
                    move_cancel(character)
                elseif is3 then
                    tween_position(rootPart, goal, DIST_SHOOTING3)
                    precise_wait(SHOOTING3_WAIT) -- settle before the deep shot
                    shoot(get_timing("Shooting3", 0.4))
                else
                    tween_position(rootPart, goal, DIST_SHOOTING2)
                    shoot(get_timing("Shooting2", 0.4))
                end
            end
        end)
    end

    ------------------------------------------------------------
    -- MAIN: Playmaking (_G.Playmaking) — tween to spacing, then
    -- spam H dribbles in cycles (7s on / 4s off)
    ------------------------------------------------------------
    if localPlayer.Name == _G.Main then
        task.spawn(function()
            while task.wait() do
                if _G.Stop then
                    print("[PLAYMAKING] Stopped (_G.Stop = true)")
                    break
                end
                if not _G.Playmaking then continue end

                local character = localPlayer.Character
                if not character then continue end
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if not rootPart then continue end

                local goal = get_goal(character)
                if not goal then continue end

                -- No ball: the camera-walk ball chase handles getting one
                if not has_ball(character) then continue end

                -- Already mid-shot: wait
                if character:GetAttribute("Action") == "Shooting" then continue end

                -- Tween to spacing distance from goal
                tween_position(rootPart, goal, DIST_PLAYMAKING)

                -- Spam dribbles: 7s on, 4s off (repeat until mode off / ball lost)
                while _G.Playmaking and not _G.Stop and has_ball(character)
                    and character:GetAttribute("Action") ~= "Shooting" do

                    -- Spam window
                    local spamStart = os.clock()
                    while _G.Playmaking and not _G.Stop and has_ball(character)
                        and ((os.clock() - spamStart) < SPAM_WINDOW) do
                        local act = character:GetAttribute("Action")
                        if act ~= "Shooting" then
                            actionRemote:FireServer({ Keys = "H", Type = "Dribble" })
                        end
                        task.wait(DRIBBLE_RATE)
                    end

                    -- Break window
                    local breakStart = os.clock()
                    while _G.Playmaking and not _G.Stop and has_ball(character)
                        and ((os.clock() - breakStart) < BREAK_WINDOW) do
                        task.wait(0.1)
                    end
                end
            end
        end)
    end

    ------------------------------------------------------------
    -- BOT: Playmaking reach (_G.PlaymakingAlt) — hover near the
    -- goal and spam Reach so dribble moves register
    ------------------------------------------------------------
    if localPlayer.Name == _G.Bot then
        task.spawn(function()
            while task.wait() do
                if _G.Stop then
                    print("[PLAYMAKING ALT] Stopped (_G.Stop = true)")
                    break
                end
                if not _G.PlaymakingAlt then continue end

                local character = localPlayer.Character
                if not character then continue end
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if not rootPart then continue end

                local goal = get_goal(character)
                if not goal then continue end

                -- Hover near the goal for positioning
                tween_position(rootPart, goal, ALT_REACH_DISTANCE)

                -- Send reach immediately (no sync gating)
                actionRemote:FireServer({
                    Action = "Reach",
                    Reach = true
                })
                task.wait(0.2)
            end
        end)
    end

    ------------------------------------------------------------
    -- 🔀 MULTI MODE (_G.MultiMode): Playmaking for
    -- _G.MultiModeTime minutes, then switch to Finishing
    ------------------------------------------------------------
    if _G.MultiMode then
        task.spawn(function()
            local minutes = _G.MultiModeTime or 3
            local duration = minutes * 60

            -- wait for the match to actually start
            while true do
                if _G.Stop then return end
                local char = localPlayer.Character
                local court = char and char:GetAttribute("InGame")
                if court and court ~= "" then break end
                task.wait(0.5)
            end

            -- Phase 1: Playmaking
            if localPlayer.Name == _G.Main then
                _G.Playmaking = true
                _G.Finishing  = false
                _G.Shooting2  = false
                _G.Shooting3  = false
                print(string.format("[MULTI MODE] Phase 1: Playmaking for %d min.", minutes))
            elseif localPlayer.Name == _G.Bot then
                _G.PlaymakingAlt = true
                print("[MULTI MODE] Bot reach mode ON for phase 1.")
            end

            -- run phase 1 for the configured time
            local start = tick()
            while tick() - start < duration do
                task.wait(1)
                if _G.Stop then return end
            end

            -- Phase 2: Finishing
            if localPlayer.Name == _G.Main then
                _G.Playmaking = false
                _G.Finishing  = true
                _G.Shooting2  = false
                _G.Shooting3  = false
                print("[MULTI MODE] Phase 2: switched to Finishing.")
            elseif localPlayer.Name == _G.Bot then
                _G.PlaymakingAlt = false
                print("[MULTI MODE] Bot reach mode OFF — back to spot for phase 2.")
            end
        end)
    end

