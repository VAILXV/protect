    ---------------------------------------------------------------------
    -- BOT: Follow Main player
    ---------------------------------------------------------------------
    -- Guard so only ONE follow loop can ever run at a time (they used to
    -- stack up and keep firing teleports after Main was already found)
    local followRunning = false

    -- After leaving a match early, wait this long before chasing Main again
    -- (Main is still IN the match — following it there just triggers the
    -- "Teleport restricted" prompt and freezes the bot)
    local FOLLOW_COOLDOWN = 90 -- seconds

    -- Should the bot actually try to follow right now?
    local function botShouldFollow()
        -- Main is already in this server → nothing to follow
        if isPlayerInServer(_G.Main) then return false end

        -- We're queued up → Main vanishing means the MATCH is starting and
        -- our own teleport is about to fire. Following now would drag the
        -- bot into Main's game server as a stuck spectator.
        local char = localPlayer.Character
        if char and char:GetAttribute("InQueue") then return false end

        -- We just left a match on the alt timer → Main is still playing and
        -- can't be followed yet. Wait out the cooldown before chasing.
        local leftAt = 0
        pcall(function()
            leftAt = tonumber(TeleportService:GetTeleportSetting("BotLeftMatchAt")) or 0
        end)
        if leftAt > 0 and (os.time() - leftAt) < FOLLOW_COOLDOWN then
            return false
        end

        return true
    end

    local function followMainPlayer()
        if localPlayer.Name ~= _G.Bot then return end
        if followRunning then return end
        followRunning = true
        print("[BOT] followMainPlayer started.")

        while task.wait(CHECK_INTERVAL) do
            if game.PlaceId ~= FOLLOW_PLACE_ID then
                print("[BOT] Not in follow place ID yet.")
                continue
            end

            if not botShouldFollow() then
                print("[BOT] Follow no longer needed — stopping follow loop.")
                break
            end

            local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
            local friendsRemote = remotesFolder and remotesFolder:FindFirstChild("Friends")

            if friendsRemote then
                local args = {
                    { FriendUser = _G.Main, Type = "TeleportToPlayer" }
                }
                friendsRemote:FireServer(unpack(args))
