                if not isPlayerInServer(_G.Main) then
                    print("[BOT] Main not found — trying follow...")
                    task.spawn(followMainPlayer)
                end
            end
        end)
    end
 
    -- ✅ Wait for both players to fully load
    local loaded = waitForBothPlayers()
    if not loaded then
        warn("[SYNC] Aborting logic due to failed loading.")
        return
    end
 
    startQueueCheck()
 
    ---------------------------------------------------------------------
-- ✅ waitForBothPlayers() - Clean, reliable load verification
---------------------------------------------------------------------
end
 
