    ------------------------------------------------------------
    -- Finishing Action Logic
    ------------------------------------------------------------
    local function runFinishingActions()
        print("[DEBUG] Finishing is true. Running finishing logic...")
 
        local lookTarget = Vector3.new(-101, 71, 135)
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = CFrame.new(camera.CFrame.Position, lookTarget)
 
        local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
        local rootPart = character:WaitForChild("HumanoidRootPart")
 
        -- 🟢 Teleport to finishing position first
        local finishPos = Vector3.new(-102, 71, 113)
        rootPart.CFrame = CFrame.new(finishPos)
        print("[DEBUG] Teleported to finishing position:", finishPos)
 
        -- 🟠 Start walking immediately
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
        print("[DEBUG] Started walking forward.")
 
        -- 🔵 After 0.5s, start holding E for 1s (while still walking)
        task.delay(0.5, function()
            if _G.Stop then return end
            print("[DEBUG] Holding E (0.5s into walk)")
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            print("[DEBUG] Released E")
        end)
 
        -- 🟣 Stop walking after 1s total
        task.delay(1, function()
            if _G.Stop then return end
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
            camera.CameraType = Enum.CameraType.Custom
            print("[DEBUG] Stopped walking and restored camera.")
        end)
    end
 
    local function teleportAndVerify(rootPart, targetPosition, label)
        rootPart.CFrame = CFrame.new(targetPosition)
        task.wait(0.3)
        local actualPos = rootPart.Position
        local distance = (actualPos - targetPosition).Magnitude
 
        if distance <= 3 then
            print(string.format("[TELEPORT SUCCESS] %s arrived at target (%.2f studs away)", label, distance))
            return true
        else
            warn(string.format("[TELEPORT FAIL] %s ended up %.2f studs away", label, distance))
            return false
        end
    end
    ------------------------------------------------------------
    -- Main Shoot Logic
    ------------------------------------------------------------
    local function mainShootLogic()
        local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
        local rootPart  = character:WaitForChild("HumanoidRootPart", 3)
        if not rootPart then return end
 
        local shootPosition
 
        if _G.Three then
            shootPosition = Vector3.new(-118, 70, 94)
        elseif _G.Two then
            shootPosition = Vector3.new(-101, 70, 110)
        elseif _G.Finishing then
            shootPosition = Vector3.new(-102, 71, 113)
        else
            warn("No shot type selected (_G.Three / _G.Two / _G.Finishing)")
            return
        end
 
        rootPart.CFrame = CFrame.new(shootPosition)
        print("Teleported to:", shootPosition)
 
        -- ✅ Verify teleport before pressing E or running finishing actions
        if teleportAndVerify(rootPart, shootPosition, "Main shot position") then
            if _G.Three or _G.Two then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(1)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            elseif _G.Finishing then
                runFinishingActions()
            end
        else
            warn("[SHOT] Teleport failed — skipping E press.")
        end
    end
 
