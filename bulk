do
    local Players = game:GetService("Players")

    local function isProtected(player)
        return player == Players.LocalPlayer
            or player.Name == _G.Bot
            or player.Name == _G.Main
    end

    local function removePlayerCharacter(player)
        if isProtected(player) then return end

        local character = player.Character
        if character then
            character:Destroy()
        end

        player.CharacterAdded:Connect(function(char)
            if not isProtected(player) then
                task.wait()
                char:Destroy()
            end
        end)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        removePlayerCharacter(player)
    end

    Players.PlayerAdded:Connect(removePlayerCharacter)
end

