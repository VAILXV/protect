            end
        end

        followRunning = false
    end

    ---------------------------------------------------------------------
    -- MAIN & BOT: Queue logic (attribute-based: single join + timeout hop)
    ---------------------------------------------------------------------
    local QUEUE_DELAY = 3
    local QUEUE_TIMEOUT = _G.QueueTime or 17

    local function joinQueue(value)
        local queueRemote = ReplicatedStorage:WaitForChild("Queue")
        queueRemote:FireServer({
            [value and "JoinQueue" or "LeaveQueue"] = true
        })
        print(value and "[QUEUE] JoinQueue fired." or "[QUEUE] LeaveQueue fired.")
    end

    local function serverHop()
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true",
            game.PlaceId
        )
        local ok, body = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        local servers = {}
        if ok and body and body.data then
            for _, v in next, body.data do
                if type(v) == "table" and tonumber(v.playing) and tonumber(v.maxPlayers)
                    and v.playing < v.maxPlayers and v.id ~= game.JobId then
                    table.insert(servers, 1, v.id)
                end
            end
        end

        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], localPlayer)
        else
            -- Fallback: let Roblox pick an instance
            TeleportService:Teleport(game.PlaceId, localPlayer)
        end
    end

    local function startQueueLogic()
        local spots = workspace:WaitForChild("Spots")
        local onesSpot = spots:WaitForChild("1v1")

        local otherName = (localPlayer.Name == _G.Main) and _G.Bot or _G.Main

        -- persistent camera-walk toward the spot (start/stop as needed)
        local walkConn = nil
        local lastPress = 0

        local function stopWalking()
            if walkConn then
                walkConn:Disconnect()
                walkConn = nil
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            end
        end

        local function startWalking()
            if walkConn then return end
            local camera = workspace.CurrentCamera
            camera.CameraType = Enum.CameraType.Scriptable
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
            lastPress = tick()
            print("[WALK] Walking to 1v1 spot:", onesSpot.Position)

            walkConn = RunService.RenderStepped:Connect(function()
                local char = localPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local target = onesSpot.Position
                local flatTarget = Vector3.new(target.X, hrp.Position.Y, target.Z)
                local dist = (flatTarget - hrp.Position).Magnitude

                -- keep camera behind the character, looking at the spot
                if dist > 0.1 then
                    local dir = (flatTarget - hrp.Position).Unit
                    camera.CFrame = CFrame.lookAt(
                        hrp.Position - dir * 10 + Vector3.new(0, 5, 0),  -- behind & above
                        flatTarget
                    )
                end

                -- 🔁 re-hold W every 0.25s so mouse clicks can't cancel the walk
                if tick() - lastPress >= 0.25 then
                    lastPress = tick()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                end
            end)
        end

        ---------------------------------------------------------------
        -- 1) Wait until both players are here, loaded, and at the spot
        ---------------------------------------------------------------
        while task.wait() do
            if _G.Stop then
                stopWalking()
                return
            end

            local char = localPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            -- already in queue? skip straight ahead
            if char and char:GetAttribute("InQueue") then
                stopWalking()
                break
            end

            local otherPlayer = Players:FindFirstChild(otherName)
            if not otherPlayer then
                -- other account not here yet (bot's follow loops handle chasing Main)
                stopWalking()
                continue
            end

            -- wait for the other account's data to fully load
            if not (otherPlayer:GetAttribute("Loaded") and otherPlayer:GetAttribute("LoadedData")) then
                continue
            end

            local otherChar = otherPlayer.Character
            local otherRoot = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
            if not (hrp and otherRoot) then
                continue
            end

            local distFromOther = (hrp.Position - otherRoot.Position).Magnitude
            local distFromSpot = (hrp.Position - onesSpot.Position).Magnitude
            local otherFromSpot = (onesSpot.Position - otherRoot.Position).Magnitude

            -- 🚶 camera-walk toward the spot, with hysteresis:
            -- stop once within 3.5 studs, and only start again if we
            -- drift past 6 — prevents the camera rapidly toggling
            -- Scriptable/Custom when hovering right at the edge
            if walkConn then
                if distFromSpot <= 3.5 then
                    stopWalking()
                end
            else
                if distFromSpot > 6 then
                    startWalking()
                end
            end

            -- both players on the spot and near each other → ready
            if distFromOther < 5 and distFromSpot < 5 and otherFromSpot < 5 then
                break
            end
        end

        stopWalking()

        ---------------------------------------------------------------
        -- 2) Small delay, then a single JoinQueue
        ---------------------------------------------------------------
        task.wait(QUEUE_DELAY)
        joinQueue(true)

        ---------------------------------------------------------------
        -- 3) Still here after QUEUE_TIMEOUT? Leave queue and hop
        ---------------------------------------------------------------
        task.delay(QUEUE_TIMEOUT, function()
            if _G.Stop then return end
            print("[QUEUE] Timed out after " .. QUEUE_TIMEOUT .. "s — leaving queue and hopping.")
            joinQueue(false)

            while task.wait(1) do
                if _G.Stop then break end
                if localPlayer.Name == _G.Main then
                    serverHop()
                else
                    -- only chase Main if it's actually gone and we're not queued
                    if botShouldFollow() then
                        local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
                        local friendsRemote = remotesFolder and remotesFolder:FindFirstChild("Friends")
                        if friendsRemote then
                            friendsRemote:FireServer({
                                FriendUser = _G.Main;
                                Type = "TeleportToPlayer";
                            })
                        end
                    end
                end
            end
        end)
    end

    ---------------------------------------------------------------------
    -- Run logic
    ---------------------------------------------------------------------
