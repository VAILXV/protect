    ------------------------------------------------------------
    -- Alternating Ball Pickup + Shot Mode Logic
    ------------------------------------------------------------
 
    local shotCycle = {}
    local currentIndex = 1
 
    local function setupShotCycle()
        shotCycle = {}
        if _G.Three then table.insert(shotCycle, "Three") end
        if _G.Two then table.insert(shotCycle, "Two") end
        if _G.Finishing then table.insert(shotCycle, "Finishing") end
    end
    setupShotCycle()
 
    local function getNextShotMode()
        if #shotCycle == 0 then return "None" end
        local mode = shotCycle[currentIndex]
        currentIndex = currentIndex + 1
        if currentIndex > #shotCycle then currentIndex = 1 end
        return mode
    end
 
    task.spawn(function()
        while true do
            task.wait(checkInterval)
            if _G.Stop then
                print("Script stopped (_G.Stop = true)")
                break
            end
 
            local isMain = localPlayer.Name == _G.Main
            local isBot  = localPlayer.Name == _G.Bot
            local has    = (isMain and hasBall(_G.Main)) or (isBot and hasBall(_G.Bot))
 
            if has and not hasBallLastFrame then
                if isMain then
                    local nextMode = getNextShotMode()
                    print("[Main] Picked up ball — switching to:", nextMode)
 
                    _G.Three     = (nextMode == "Three")
                    _G.Two       = (nextMode == "Two")
                    _G.Finishing = (nextMode == "Finishing")
 
                    mainShootLogic()
                elseif isBot then
                    print("Bot picked up ball. Running teleport logic.")
                    botTeleportLogic()
                end
            end
 
            hasBallLastFrame = has
        end
    end)
 
