    ---------------------------------------------------------------------
    -- ✅ MAIN: Find better server if not near 10 players
    ---------------------------------------------------------------------
    if localPlayer.Name == _G.Main then
        local currentCount = #Players:GetPlayers()
 
        if currentCount < MIN_PLAYERS or currentCount > MAX_PLAYERS then
            print("[SERVER CHECK] Player count is", currentCount, "- searching for better server...")
 
            local function listServers(cursor)
                local url = string.format(
                    "https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100",
                    PLACE_ID
                )
                if cursor then
                    url = url .. "&cursor=" .. cursor
                end
                local success, result = pcall(function()
                    return HttpService:JSONDecode(game:HttpGet(url))
                end)
                if success and result and result.data then
                    return result
                else
                    warn("[SERVER CHECK] Failed to fetch server list.")
                    return nil
                end
            end
 
            local bestServer, bestDiff, cursor = nil, math.huge, nil
            repeat
                local servers = listServers(cursor)
                if not servers then break end
                for _, s in ipairs(servers.data) do
                    if s.playing < s.maxPlayers then
                        local diff = math.abs(s.playing - TARGET_PLAYER_COUNT)
                        if diff < bestDiff then
                            bestDiff = diff
                            bestServer = s
                        end
                        if s.playing == TARGET_PLAYER_COUNT then
                            bestServer = s
                            break
                        end
                    end
                end
                cursor = servers.nextPageCursor
            until not cursor or (bestServer and bestServer.playing == TARGET_PLAYER_COUNT)
 
            if bestServer then
                print(string.format("[SERVER CHECK] Teleporting to server with %d players (ID: %s)", bestServer.playing, bestServer.id))
                TeleportService:TeleportToPlaceInstance(PLACE_ID, bestServer.id, localPlayer)
                return
            else
