    ---------------------------------------------------------------------
    -- MAIN & BOT: Queue joining logic + detection for when Main leaves
    ---------------------------------------------------------------------
    local function startQueueCheck()
        local textLabel
        pcall(function()
            textLabel = workspace:WaitForChild("1v1Queue"):WaitForChild("SuraceGui"):WaitForChild("Queue")
        end)
        if not textLabel or not textLabel:IsA("TextLabel") then
            warn("Queue TextLabel not found")
            return
        end
 
        local running, stopLoop = false, false
        local inJoinLoop = false
        local togetherStart = 0
        local leftMainAt = nil
        local walking = false
 
        -----------------------------------------------------------------
        -- 🚶 WALK to the 1v1 spot instead of teleporting
        -----------------------------------------------------------------
        local function walkToSpot(onArrived)
            if walking then return end
            walking = true
 
            local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if not hrp then
                warn("[WALK] No HumanoidRootPart found.")
                walking = false
                return
            end
 
            local spotsFolder = workspace:FindFirstChild("Spots")
            local spot = spotsFolder and spotsFolder:FindFirstChild("1v1")
 
            -- Fallback: if Spots.1v1 doesn't exist, use the old teleport position
            if not spot then
                warn("[WALK] workspace.Spots['1v1'] not found — falling back to teleport.")
                hrp.CFrame = CFrame.new(teleportPosition)
                walking = false
                if onArrived then task.spawn(onArrived) end
                return
            end
 
            local target = spot.Position
            local camera = workspace.CurrentCamera
 
            -- take over the camera so the default camera scripts don't fight us
            local oldType = camera.CameraType
            camera.CameraType = Enum.CameraType.Scriptable
 
            -- start walking
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
            print("[WALK] Walking to 1v1 spot:", target)
 
            local startTime = tick()
            local lastPress = tick()
            local conn
            conn = RunService.RenderStepped:Connect(function()
                local flatTarget = Vector3.new(target.X, hrp.Position.Y, target.Z)
                local distance = (flatTarget - hrp.Position).Magnitude
                local timedOut = tick() - startTime > 30
 
                -- keep camera behind the character, looking at the target
                if distance > 0.1 then
                    local dir = (flatTarget - hrp.Position).Unit
                    camera.CFrame = CFrame.lookAt(
                        hrp.Position - dir * 10 + Vector3.new(0, 5, 0),  -- behind & above
                        flatTarget
                    )
                end
 
                -- 🔁 re-hold W every 0.25s so mouse clicks can't cancel the walk
                if distance > 3.5 and tick() - lastPress >= 0.25 then
                    lastPress = tick()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                end
 
                if distance <= 3.5 or timedOut or stopLoop or _G.Stop then
                    -- stop walking + give the camera back
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                    camera.CameraType = oldType
                    conn:Disconnect()
                    walking = false
 
                    if distance <= 3.5 then
                        print("[WALK] Arrived at 1v1 spot.")
                        if onArrived then task.spawn(onArrived) end
                    elseif timedOut then
                        warn("[WALK] Timed out walking to spot — teleporting as fallback.")
                        hrp.CFrame = CFrame.new(target)
                        if onArrived then task.spawn(onArrived) end
                    else
                        print("[WALK] Walk cancelled (_G.Stop or other player left).")
                        running = false
                    end
                end
            end)
        end
 
        local function joinLoop()
            inJoinLoop = true
            while not stopLoop do
                task.wait(1)
                joinedQueue = true
                local args = {
                    {
                        JoinQueue = true
                    }
                }
                ReplicatedStorage:WaitForChild("Queue"):FireServer(unpack(args))
                print("Join (loop)")
            end
            running = false
            inJoinLoop = false
        end
 
        local function onTextChanged()
            local isQueueEmpty = textLabel.Text == "0 In Queue"
            local isMain = localPlayer.Name == _G.Main
            local isBot = localPlayer.Name == _G.Bot
 
            local otherInServer = false
            if isMain then
                otherInServer = isPlayerInServer(_G.Bot)
            elseif isBot then
                otherInServer = isPlayerInServer(_G.Main)
            else
                return
            end
 
            -- Track join/leave duration
            if otherInServer then
                if togetherStart == 0 then togetherStart = tick() end
                leftMainAt = nil
            else
                if not leftMainAt then
                    leftMainAt = tick()
                end
            end
 
            -- Detect if Main has been gone for 2 seconds
            if localPlayer.Name == _G.Bot then
                task.spawn(function()
                    while true do
                        task.wait(1)
                        if not isPlayerInServer(_G.Main) then
                            print("[BOT] Main not found — trying follow...")
                            task.spawn(followMainPlayer)
                        end
                    end
                end)
            end
 
            if otherInServer then
                if not running then
                    running, stopLoop = true, false
                    -- 🚶 Walk to the queue spot FIRST, then wait there until the queue is 0
                    walkToSpot(function()
                        print("[QUEUE] At queue spot — waiting for '0 In Queue'...")
                        while not stopLoop and not _G.Stop do
                            if textLabel.Text == "0 In Queue" then
                                print("Queue is 0. Starting Join Loop...")
                                task.spawn(joinLoop)
                                return
                            end
                            task.wait(0.5)
                        end
                        print("[QUEUE] Wait cancelled before queue reached 0.")
                        running = false
                    end)
                elseif inJoinLoop and not isQueueEmpty then
                    -- we're in the queue now — stop spamming join
                    print("Stopped Join Loop.")
                    stopLoop = true
                end
            else
                if running then
                    print("Stopped Join Loop (other player left).")
                    stopLoop = true
                end
            end
        end
 
        textLabel:GetPropertyChangedSignal("Text"):Connect(onTextChanged)
        Players.PlayerAdded:Connect(onTextChanged)
        Players.PlayerRemoving:Connect(onTextChanged)
        onTextChanged()
    end
 
    local function isCharacterFullyLoaded(playerName)
        local char = workspace:FindFirstChild(playerName)
        if not char then
            return false, "❌ Character not found"
        end
 
        local humanoid = char:FindFirstChildWhichIsA("Humanoid")
        local rootPart = char:FindFirstChild("HumanoidRootPart")
        local ff = char:FindFirstChildOfClass("ForceField")
 
        -- Basic safety checks
        if not humanoid then
            return false, "❌ No Humanoid"
        end
        if not rootPart then
            return false, "❌ No HumanoidRootPart"
        end
        if humanoid.Health <= 0 then
            return false, "💀 Dead humanoid"
        end
 
        -- ✅ Only keep the ForceField check
        if ff then
            return false, "⏳ Still has ForceField"
        end
 
        -- ✅ Everything else is ignored
        return true, "✅ Fully loaded (no ForceField)"
    end
 
    local function waitForBothPlayers(timeout)
        timeout = timeout or 90
        local start = tick()
 
        print("[SYNC] Waiting for both players to fully load (no ForceField, grounded, alive, etc.)...")
 
        while tick() - start < timeout do
            local mainReady, mainMsg = isCharacterFullyLoaded(_G.Main)
            local botReady, botMsg   = isCharacterFullyLoaded(_G.Bot)
 
            print(string.format("[SYNC] %s → %s", _G.Main, mainMsg))
            print(string.format("[SYNC] %s → %s", _G.Bot, botMsg))
 
            if mainReady and botReady then
                print("\n✅ [SYNC] Both players fully loaded, grounded, and ready.\n")
                return true
            end
 
            task.wait(1)
        end
 
        warn("[SYNC] ❌ Timeout while waiting for both players to finish loading.")
        return false
    end
 
    ---------------------------------------------------------------------
    -- Run logic
    ---------------------------------------------------------------------
    if localPlayer.Name == _G.Bot and not isPlayerInServer(_G.Main) then
