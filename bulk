    -- Wait until within maxDist studs of target (ignoring height), or timeout
    local function wait_until_near(rootPart, target, maxDist, timeout)
        local start = tick()
        while true do
            local p = (typeof(target) == "Instance") and target.Position or target
            local d = (rootPart.Position - Vector3.new(p.X, rootPart.Position.Y, p.Z)).Magnitude
            if d <= (maxDist or 3) then return true end
            if timeout and (tick() - start) >= timeout then return false end
            task.wait()
        end
    end
 
    -- Tween to a spot `distance` studs out from the goal, facing it
    local function tween_position(rootPart, part, distance)
        local root_position = rootPart.Position
        local part_position = part.Position
 
        local target_position = Vector3.new(part_position.X, root_position.Y, part_position.Z)
        local backward = -part.CFrame.LookVector
        local target_distance = -backward * distance
 
        local distance_to_travel = (root_position - target_position).Magnitude
        local time = distance_to_travel / TWEEN_SPEED
 
        local tween_info = TweenInfo.new(time, Enum.EasingStyle.Linear, Enum.EasingDirection.In)
        local tween = TweenService:Create(rootPart, tween_info, {
            CFrame = CFrame.lookAt(target_position + target_distance, target_position)
        })
        tween:Play()
        tween.Completed:Wait()
    end
 
    -- Resolve the hoop goal for the court we're playing on
    local function get_goal(char)
        local courtName = char:GetAttribute("InGame")
        if not courtName or courtName == "" then return nil end
        local map = workspace:FindFirstChild("Map")
        local courts = map and map:FindFirstChild("Courts")
        local court = courts and courts:FindFirstChild(courtName)
        local hoop = court and court:FindFirstChild("Hoop2")
        local rim = hoop and hoop:FindFirstChild("Rim")
        return rim and rim:FindFirstChild("Goal")
    end
 
