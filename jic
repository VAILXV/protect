-----------------------------------------------------------[SHARED STEAL ENGINE]-----------------------------------------------------------------------------
--  Shared by the REC block and the Park block -- it was inlined in REC before
--  the Park needed the same thing, so it lives out here now.
--
--  The remote name inside PlayerEvents is generated per server, so a hardcoded
--  path dies on every hop. A __namecall hook watches the FireServer calls the
--  GAME makes; the one carrying "Steal" as an argument IS the steal remote, by
--  definition -- the game just used it to steal. Do ONE steal yourself and it
--  is learned for that server.
--
--  REC has a PlayerEvents.Physical worth falling back to. The Park does NOT --
--  its PlayerEvents holds only per-server scrambled names -- so in the Park the
--  hook is the only way in and one manual steal is mandatory, not optional.
--
--  The script never presses the steal key for you. It watches, learns, and
--  spams the remote it learned once a farm toggle is on.
--------------------------------------------------------------------------------------------------------------------------------------------------------------
--  Both engines fire remotes themselves, and both ride the ONE __namecall hook
--  below. This flag tells that hook "this call is ours" so it never relearns a
--  remote from our own traffic. RH2_STEAL_FIRING is set alongside it purely so
--  a hook left behind by an older injection still recognises us.
local function setAutoFiring(on)
    getgenv().RH2_AUTO_FIRING  = on
    getgenv().RH2_STEAL_FIRING = on
end

--  Marker string the game sends as an argument -> the getgenv slot the remote
--  that sent it is stored in. One hook learns every action listed here, so
--  shooting costs nothing extra on the hot path: it is one more table lookup
--  on a string we were already comparing.
local LEARN_SLOTS = {
    Steal    = "RH2_STEAL_REMOTE",
    Shooting = "RH2_SHOOT_REMOTE",
}

local StealEngine = {}
do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer

    StealEngine.STEAL_INTERVAL = 0.01      -- 0.01 was 100 fires/sec into a cooldown:
                                           -- not a faster steal, just a throttled flood
    StealEngine.STEAL_MARKER   = "Steal"   -- arg 2 on a steal; what the hook matches
    StealEngine.TARGET_MODE    = "SELF"    -- "SELF" | "CLOSEST" | "NAME"
    StealEngine.TARGET_NAME    = ""        -- only for "NAME"
    StealEngine.TARGET_RANGE   = 50        -- only for "CLOSEST"; math.huge to ignore distance
    StealEngine.PRINT_DEBUG    = true

    local function dprint(...)
        if StealEngine.PRINT_DEBUG then print("[AUTO STEAL]", ...) end
    end
    StealEngine.dprint = dprint

    --  Bumped on every re-execute so a loop from a previous injection sees a
    --  stale generation and exits instead of double-firing alongside this one.
    getgenv().RH2_STEAL_GEN = (getgenv().RH2_STEAL_GEN or 0) + 1
    local MY_GEN = getgenv().RH2_STEAL_GEN

    function StealEngine.isCurrentGen()
        return getgenv().RH2_STEAL_GEN == MY_GEN
    end

    --  ██  LEARN THE REMOTE  ██
    --  The learned remote lives in getgenv, not a local: hookmetamethod cannot
    --  be undone, so a re-executed script inherits whatever the old hook
    --  already learned instead of starting from zero.
    local function fallbackRemote()
        local pe = ReplicatedStorage:FindFirstChild("PlayerEvents")
        return pe and pe:FindFirstChild("Physical") or nil
    end

    function StealEngine.currentRemote()
        local r = getgenv().RH2_STEAL_REMOTE
        if r and r.Parent then return r, true end
        if r then
            --  Parent went nil (hop, remote replaced): forget it and relearn
            --  rather than firing at a dead instance forever.
            getgenv().RH2_STEAL_REMOTE = nil
            dprint("learned remote went stale -- relearning")
        end
        return fallbackRemote(), false
    end

    --  Versioned, not a plain boolean: a hook installed by an older injection
    --  would otherwise block this one from ever going in. A newer hook simply
    --  layers on top -- the old one still runs underneath through old(...).
    --
    --  ██ BUMP THIS NUMBER WHENEVER LEARN_SLOTS CHANGES ██
    --  The installed hook closes over the LEARN_SLOTS table it was built with,
    --  so editing the table does nothing to a hook that is already in. Leaving
    --  the version alone after adding Shooting back is exactly that bug: the
    --  old steal-only hook stayed resident and no amount of shooting could
    --  load the shoot remote until Roblox itself was restarted.
    local HOOK_VER = 3
    if getgenv().RH2_HOOK_VER ~= HOOK_VER then
        if hookmetamethod and checkcaller and getnamecallmethod then
            local installed = pcall(function()
                local old
                old = hookmetamethod(game, "__namecall", function(self, ...)
                    --  ██ HOT PATH -- runs on EVERY namecall ██
                    --  Cheapest early-outs first, in cost order.
                    --  RH2_AUTO_FIRING guards re-entry: our own fires would
                    --  otherwise look like real actions and it would relearn
                    --  the remotes from itself.
                    if getgenv().RH2_AUTO_FIRING or getgenv().RH2_STEAL_FIRING
                        or checkcaller() then
                        return old(self, ...)
                    end
                    if getnamecallmethod() ~= "FireServer" then
                        return old(self, ...)
                    end
                    local parent = self.Parent
                    if not parent or parent.Name ~= "PlayerEvents" then
                        return old(self, ...)
                    end

                    --  Read the varargs in place -- no table.pack, no allocation.
                    for i = 1, select("#", ...) do
                        local a = select(i, ...)
                        if type(a) == "string" then
                            local slot = LEARN_SLOTS[a]
                            if slot then
                                if getgenv()[slot] ~= self then
                                    getgenv()[slot] = self
                                    print(("[AUTO FARM] LEARNED %s remote: %s")
                                        :format(a, self.Name))
                                end
                                break
                            end
                        end
                    end

                    return old(self, ...)
                end)
            end)
            getgenv().RH2_STEAL_HOOK = installed or nil
            getgenv().RH2_HOOK_VER   = installed and HOOK_VER or nil
            if not installed then
                dprint("WARNING: __namecall hook failed to install -- falling back")
                dprint("         to PlayerEvents.Physical, which does not exist in the Park")
            end
        else
            dprint("WARNING: executor lacks hookmetamethod/checkcaller/getnamecallmethod")
            dprint("         -- cannot learn the remote, using PlayerEvents.Physical")
        end
    end

    --  ██  TARGET  ██
    --  Resolved fresh on every fire, never cached: characters are replaced on
    --  every respawn, so a target grabbed once goes stale the first time
    --  anyone resets. workspace.Humanoids is looked up per call rather than
    --  waited on at load -- a WaitForChild out here would hang the whole
    --  script in a place that has no such folder.
    function StealEngine.resolveTarget()
        local humanoids = workspace:FindFirstChild("Humanoids")

        if StealEngine.TARGET_MODE == "SELF" then
            --  Works alone in an empty server and needs nothing edited when
            --  you switch accounts.
            local mine = (humanoids and humanoids:FindFirstChild(LocalPlayer.Name))
                or LocalPlayer.Character
            if not mine then return nil, "no character" end
            return mine
        end

        if not humanoids then return nil, "no workspace.Humanoids in this place" end

        if StealEngine.TARGET_MODE == "NAME" then
            if StealEngine.TARGET_NAME == "" then return nil, "TARGET_NAME is empty" end
            local t = humanoids:FindFirstChild(StealEngine.TARGET_NAME)
            if not t then
                return nil, ("%q not in workspace.Humanoids"):format(StealEngine.TARGET_NAME)
            end
            return t
        end

        --  CLOSEST
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil, "no HumanoidRootPart" end

        local best, bestDist = nil, math.huge
        for _, m in ipairs(humanoids:GetChildren()) do
            if m ~= myChar then
                local root = m:FindFirstChild("HumanoidRootPart")
                    or m:FindFirstChild("UpperTorso")
                    or m:FindFirstChild("Torso")
                if root then
                    local d = (root.Position - myRoot.Position).Magnitude
                    if d < bestDist and d <= StealEngine.TARGET_RANGE then
                        best, bestDist = m, d
                    end
                end
            end
        end

        if not best then
            return nil, ("nobody within %d studs"):format(StealEngine.TARGET_RANGE)
        end
        return best
    end

    function StealEngine.fireSteal()
        local remote = StealEngine.currentRemote()
        if not remote then return false, "no steal remote (not learned, no fallback)" end

        local char = LocalPlayer.Character
        if not char then return false, "no character" end

        local hand = char:FindFirstChild("RightHand")
        if not hand then return false, "no RightHand" end

        local target, err = StealEngine.resolveTarget()
        if not target then return false, err end

        setAutoFiring(true)
        local ok, ferr = pcall(function()
            remote:FireServer(true, StealEngine.STEAL_MARKER, target, hand)
        end)
        setAutoFiring(false)

        if not ok then return false, tostring(ferr) end
        return true
    end

    --  Rate-limits the failure log: without it a missing target prints twice
    --  a second forever and buries everything else in the console.
    local lastFailMsg, lastFailAt = nil, 0
    function StealEngine.logFailure(err)
        local now = os.clock()
        if err ~= lastFailMsg or (now - lastFailAt) > 5 then
            dprint("steal failed --", err)
            lastFailMsg, lastFailAt = err, now
        end
    end

    --  Manual controls from the console.
    _G.AutoStealStatus = function()
        local r, isLearned = StealEngine.currentRemote()
        print(("[AUTO STEAL] rec=%s  park=%s  remote=%s (%s)  mode=%s"):format(
            tostring(_G.AutoDefensive),
            tostring(_G.ParkAutoDefensive),
            r and r.Name or "none",
            isLearned and "learned" or "fallback",
            StealEngine.TARGET_MODE))
        local t, err = StealEngine.resolveTarget()
        print(("[AUTO STEAL] target resolves to: %s"):format(
            t and t.Name or ("<" .. tostring(err) .. ">")))
    end

    _G.AutoStealFire = function() return StealEngine.fireSteal() end
end

-----------------------------------------------------------[SHARED SHOOT ENGINE]----------------------------------------------------------------------------
--  This does NOT shoot for you. It multiplies the shots you take yourself:
--  toggle it on, set how many events each charge is worth, then shoot.
--
--  The remote is LOADED the same way the steal one is: the same __namecall
--  hook watches for a FireServer carrying "Shooting", so one real shot teaches
--  it the name for that server. PlayerEvents.Shooting is tried first and is
--  enough on servers that still expose the plain name; where it is scrambled
--  the hook is the only way in and one manual shot is required.
--
--  TIMING is the part that actually mattered. The server only accepts a shot
--  event while the shot is CHARGING; fired after the release it lands on
--  nothing, which is why the old code could run a full multiplier and move no
--  XP. So the multiplier rides the rising ticks of Backpack.ActionValues.Power
--  -- the charge meter filling while E is held.
--------------------------------------------------------------------------------------------------------------------------------------------------------------
local ShootEngine = {}
do
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer

    ShootEngine.SHOOT_MARKER  = "Shooting"        -- arg 2 on a shot
    ShootEngine.SHOT_TYPE     = "Standing Shot"   -- arg 3
    ShootEngine.BURST_DELAY   = 0                 -- the charge is short; do not spend it waiting
    ShootEngine.MULT_VALUES   = { '1', '25', '45', '65' }
    ShootEngine.DEFAULT_MULT  = 1                 -- until the dropdown has been read
    ShootEngine.DEFAULT_POWER = 50                -- until the slider has been read
    ShootEngine.PRINT_DEBUG   = true

    --  The on-screen warning that runs while the multiplier is live.
    ShootEngine.WARN_TEXT  = "⚠ SHOOTING XP ON ⚠"
    ShootEngine.WARN_HZ    = 1.5    -- flashes per second
    ShootEngine.WARN_MIN_T = 0.3    -- most solid the letters get
    ShootEngine.WARN_MAX_T = 0.9    -- faintest

    local function dprint(...)
        if ShootEngine.PRINT_DEBUG then print("[AUTO SHOOT]", ...) end
    end
    ShootEngine.dprint = dprint

    --  ██  LOAD THE REMOTE  ██
    --  Learned first, PlayerEvents.Shooting second. The plain name works on
    --  the servers that still expose it, but where the name is scrambled it
    --  resolves to nothing and the multiplier fires into thin air -- so the
    --  same __namecall hook that learns Steal also watches for "Shooting".
    --  Take ONE real shot (hold E) and it is loaded for that server.
    --
    --  The learned remote lives in getgenv, not a local: hookmetamethod cannot
    --  be undone, so a re-executed script inherits whatever the old hook
    --  already learned instead of starting from zero.
    --
    --  PlayerEvents is looked for in the BACKPACK as well as ReplicatedStorage,
    --  in that order -- which is where the original code looked first, and it
    --  is the difference between the remote being there the moment the script
    --  loads and having to shoot to teach it. Nothing here needs the toggle or
    --  a shot; both are only the last resort for a server that scrambles the
    --  name.
    local function fallbackRemote()
        local containers = {
            LocalPlayer:FindFirstChild("Backpack"),
            ReplicatedStorage,
        }
        for _, where in ipairs(containers) do
            if where then
                local pe = where:FindFirstChild("PlayerEvents")
                local r = pe and pe:FindFirstChild("Shooting")
                if r then return r end
            end
        end
        return nil
    end

    function ShootEngine.currentRemote()
        local r = getgenv().RH2_SHOOT_REMOTE
        if r and r.Parent then return r, true end
        if r then
            --  Parent went nil (hop, remote replaced): forget it and relearn
            --  rather than firing at a dead instance forever.
            getgenv().RH2_SHOOT_REMOTE = nil
            dprint("loaded remote went stale -- reloading")
        end
        return fallbackRemote(), false
    end

    --  Resolved per call, never captured: the Backpack survives a respawn but
    --  ActionValues is rebuilt, so a reference grabbed at load points at a
    --  dead instance the first time you reset -- which is the other half of
    --  why the old version stopped working after one death.
    function ShootEngine.powerValue()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local av = bp and bp:FindFirstChild("ActionValues")
        return av and av:FindFirstChild("Power") or nil
    end

    --  Both read at fire time, never captured: the point of the controls is
    --  that you can change them mid-game and the next charge uses the new
    --  numbers. The dropdown hands back its value as a STRING, hence tonumber.
    function ShootEngine.multiplier()
        local opt = Options and Options.Multiplier
        local v = opt and tonumber(opt.Value) or ShootEngine.DEFAULT_MULT
        return math.max(1, math.floor(v))
    end

    --  Power the charge has to reach before anything fires -- the "Value"
    --  slider. Below it the charge is still winding up and the shot the server
    --  would credit is a weak one.
    function ShootEngine.minPower()
        local opt = Options and Options.ChangeValue
        local v = opt and tonumber(opt.Value) or ShootEngine.DEFAULT_POWER
        return math.max(1, v)
    end

    function ShootEngine.fireBurst(count)
        local remote = ShootEngine.currentRemote()
        if not remote then return 0, "shoot remote not loaded -- take one real shot" end

        count = count or ShootEngine.multiplier()
        local sent = 0

        setAutoFiring(true)
        for i = 1, count do
            if not remote.Parent then
                remote = ShootEngine.currentRemote()
                if not remote then break end
            end

            local ok = pcall(function()
                remote:FireServer(false, ShootEngine.SHOOT_MARKER, ShootEngine.SHOT_TYPE)
            end)
            if not ok then break end
            sent = sent + 1

            if ShootEngine.BURST_DELAY > 0 and i < count then
                task.wait(ShootEngine.BURST_DELAY)
            end
        end
        setAutoFiring(false)

        return sent
    end

    --  Spawned ONCE per place block. countFn is asked how many extra fires this
    --  charge is worth and returns 0 to sit the shot out, so REC and the Park
    --  can each add their own gating without the engine knowing about either.
    function ShootEngine.spawnDriver(tag, countFn, onBurst)
        task.spawn(function()
            local bound, conn, lastPower = nil, nil, 0

            while StealEngine.isCurrentGen() do
                local power = ShootEngine.powerValue()

                if power ~= bound then
                    if conn then conn:Disconnect() conn = nil end
                    bound = power

                    if power then
                        lastPower = power.Value
                        conn = power:GetPropertyChangedSignal("Value"):Connect(function()
                            local v = power.Value
                            local rising = v > lastPower
                            lastPower = v

                            --  Rising edge only: the charge building, not it
                            --  dropping back to zero on release.
                            if not rising or v < ShootEngine.minPower() then return end
                            --  Our own fires can move Power; without this the
                            --  handler re-enters itself and multiplies.
                            if getgenv().RH2_AUTO_FIRING then return end

                            local count = countFn()
                            if not count or count < 1 then return end

                            local sent, err = ShootEngine.fireBurst(count)
                            if onBurst then onBurst(sent, err) end
                        end)
                        dprint(tag .. ": bound to Backpack.ActionValues.Power")
                    end
                end

                task.wait(1)
            end

            if conn then conn:Disconnect() end
            dprint(tag .. ": driver exited (stale generation)")
        end)
    end

    --  ██  ON-SCREEN WARNING  ██
    --  Big translucent red letters, pulsing, for as long as the multiplier is
    --  on -- so a farm left running is never mistaken for a clean session.
    --
    --  Parented to the executor's hidden container where there is one, so it
    --  does not sit in PlayerGui for anything walking the tree; CoreGui and
    --  then PlayerGui are the fallbacks.
    local function warnParent()
        if gethui then
            local ok, hui = pcall(gethui)
            if ok and hui then return hui end
        end
        local ok, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok and cg then return cg end
        return LocalPlayer:FindFirstChildOfClass("PlayerGui")
    end

    local warnGui, warnConn
    function ShootEngine.setWarning(on)
        if not on then
            if warnConn then warnConn:Disconnect() warnConn = nil end
            if warnGui then pcall(function() warnGui:Destroy() end) warnGui = nil end
            return
        end

        if warnGui and warnGui.Parent then return end   -- already up

        local built = pcall(function()
            local gui = Instance.new("ScreenGui")
            gui.Name = "RH2_ShootWarn"
            gui.IgnoreGuiInset = true
            gui.ResetOnSpawn = false        -- must survive a reset, or it lies
            gui.DisplayOrder = 10000

            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Active = false            -- never eat a click meant for the game
            label.Size = UDim2.fromScale(1, 0.22)
            label.Position = UDim2.fromScale(0, 0.30)
            label.Font = Enum.Font.GothamBlack
            label.Text = ShootEngine.WARN_TEXT
            label.TextScaled = true
            label.TextColor3 = Color3.fromRGB(255, 25, 25)
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.TextStrokeTransparency = 0.5
            label.TextTransparency = ShootEngine.WARN_MIN_T
            label.Parent = gui

            gui.Parent = warnParent()
            warnGui = gui

            --  Transparency is pulsed rather than Visible flipped: a hard blink
            --  filling the screen is punishing to sit behind for a whole farm,
            --  and reads as the same warning. Heartbeat, not RenderStepped --
            --  1.5Hz does not need a pre-render slot.
            local t0 = os.clock()
            warnConn = game:GetService("RunService").Heartbeat:Connect(function()
                --  A re-execute makes this generation stale; tear the old
                --  overlay down rather than leaving two pulsing on top of
                --  each other out of phase.
                if not StealEngine.isCurrentGen() then
                    ShootEngine.setWarning(false)
                    return
                end
                if not label.Parent then return end

                local phase = (math.sin((os.clock() - t0) * ShootEngine.WARN_HZ * math.pi * 2) + 1) / 2
                label.TextTransparency = ShootEngine.WARN_MIN_T
                    + (ShootEngine.WARN_MAX_T - ShootEngine.WARN_MIN_T) * phase
                label.TextStrokeTransparency = 0.4 + 0.5 * phase
            end)
        end)

        if not built then
            dprint("warning overlay failed to build -- multiplier still runs")
        end
    end

    local lastFailMsg, lastFailAt = nil, 0
    function ShootEngine.logFailure(err)
        local now = os.clock()
        if err ~= lastFailMsg or (now - lastFailAt) > 5 then
            dprint("shot failed --", err)
            lastFailMsg, lastFailAt = err, now
        end
    end

    --  Builds the toggle and its slider, and starts the driver behind them.
    --  gate() is an extra per-place condition; pass nil where there is none.
    --  Only one place block ever runs in a session, so the controls keep plain
    --  names and stay readable in a saved config.
    function ShootEngine.attach(groupbox, tag, gate)
        --  Indexed 'ShootingXP', not 'Shooting XP': the index is what the rest
        --  of the script says (Toggles.ShootingXP) and what a saved config
        --  keys on, and a space there is a trap. The visible text is the Text
        --  field, so nothing on screen changes.
        groupbox:AddToggle('ShootingXP', {
            Text = 'Shot Multi', Default = false,
            Callback = function(state)
                _G.ShootingXP = state
                ShootEngine.setWarning(state)

                if not state then
                    dprint(tag .. ": OFF")
                    return
                end

                local remote, isLoaded = ShootEngine.currentRemote()
                dprint(("%s: ON -- %d per charge above power %d, remote %s"):format(
                    tag, ShootEngine.multiplier(), ShootEngine.minPower(),
                    remote and (isLoaded and ("loaded (" .. remote.Name .. ")")
                            or ("fallback (" .. remote.Name .. ")"))
                        or "NOT LOADED -- take one real shot to load it"))
            end,
        })

        --  Says whether the remote is in hand yet. Kept to a few words on
        --  purpose: the groupbox is narrow and the scrambled remote names are
        --  long, so the name itself stays in _G.ShootStatus() where it has
        --  room. Wrapping is on so a theme with wider padding cannot clip it.
        local remoteLabel = groupbox:AddLabel('Remote: checking...', true)

        --  Polled rather than set once: there is nothing to report until that
        --  first shot, and a hop drops the remote, so this has to be able to
        --  go backwards too.
        task.spawn(function()
            local shown
            while StealEngine.isCurrentGen() do
                local r, isLoaded = ShootEngine.currentRemote()
                local text
                if r and isLoaded then
                    text = 'Remote: LOADED (learned)'
                elseif r then
                    text = 'Remote: LOADED (auto)'
                else
                    text = 'Remote: not loaded - shoot once'
                end

                if text ~= shown then
                    shown = text
                    remoteLabel:SetText(text)
                    dprint(tag .. ": " .. text)
                end
                task.wait(1)
            end
        end)

        groupbox:AddSlider('ChangeValue', {
            Text = 'Value', Default = ShootEngine.DEFAULT_POWER,
            Min = 1, Max = 100, Rounding = 0, Compact = true,
        })

        --  Default is an INDEX into Values, so 1 selects '1'. The old code
        --  passed 100 here, which is off the end of a four-entry list.
        groupbox:AddDropdown('Multiplier', {
            Values = ShootEngine.MULT_VALUES, Default = 1, Multi = false,
            Text = 'Ammount',
        })

        --  Unloading the menu has to take the overlay with it, or it pulses
        --  over the screen with nothing left to switch it off.
        pcall(function()
            Library:OnUnload(function() ShootEngine.setWarning(false) end)
        end)

        ShootEngine.spawnDriver(tag, function()
            if not _G.ShootingXP then return 0 end
            if gate and not gate() then return 0 end
            return ShootEngine.multiplier()
        end, function(sent, err)
            if sent == 0 and err then ShootEngine.logFailure(err) end
        end)
    end

    _G.ShootStatus = function()
        local r, isLoaded = ShootEngine.currentRemote()
        print(("[AUTO SHOOT] on=%s  remote=%s (%s)  multiplier=%d  minPower=%d"):format(
            tostring(_G.ShootingXP),
            r and r.Name or "NOT LOADED",
            isLoaded and "loaded" or "fallback",
            ShootEngine.multiplier(),
            ShootEngine.minPower()))
        local p = ShootEngine.powerValue()
        print(("[AUTO SHOOT] Power reads: %s"):format(p and tostring(p.Value) or "<not found>"))
    end

    --  Fire the shot remote by hand, e.g. _G.ShootFire(50). Only lands while a
    --  shot is actually charging -- see the timing note at the top.
    _G.ShootFire = function(count) return ShootEngine.fireBurst(count) end
end

