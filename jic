--  Park. Live check says the Park serves PlaceId 13272886093; 8026790371 is
--  kept as an alias in case a second Park place exists.
if game.PlaceId == 13272886093 or game.PlaceId == 8026790371 then
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer
    local dprint = StealEngine.dprint

    local ParkFarm = Tabs.Main:AddLeftGroupbox('Park Farm')

    local DEFENDING_CAP = 1200       -- auto-off at this much Defending XP; 0 disables

    --  ReplicatedStorage.PlayerStats holds one entry per player, keyed by
    --  username -- a StringValue with children, not a Folder, so index it by
    --  name and do not assume a Folder class. Re-resolved whenever the cached
    --  instance loses its Parent: a server hop replaces the whole subtree, and
    --  a stale IntValue would keep reading the old server's number forever.
    local cachedBadge
    local function getDefendingXP()
        if cachedBadge and cachedBadge.Parent then return cachedBadge end
        local stats = ReplicatedStorage:FindFirstChild("PlayerStats")
        local mine = stats and stats:FindFirstChild(LocalPlayer.Name)
        local badge = mine and mine:FindFirstChild("BadgeEXP")
        cachedBadge = badge and badge:FindFirstChild("Defending_Rebounding") or nil
        return cachedBadge
    end

    --  Backpack.InGame is a BoolValue: false out in the plaza, true once a
    --  game actually starts. Looked up fresh each check -- the Backpack
    --  survives respawns but the flag is rebuilt, and a captured reference
    --  would freeze the gate at whatever it read at load time.
    local function isInGame()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local flag = bp and bp:FindFirstChild("InGame")
        return flag ~= nil and flag.Value == true
    end

    local xpLabel = ParkFarm:AddLabel("Defensive XP: --", true)
    local stateLabel = ParkFarm:AddLabel("Status: idle", true)

    local function refreshXPLabel()
        local v = getDefendingXP()
        xpLabel:SetText("Defensive XP: " .. (v and tostring(v.Value) or "--"))
    end

    --  Polls for the value rather than binding once: PlayerStats fills in
    --  after join, and the subtree is swapped on a hop, so the listener has to
    --  be re-bound to whatever instance is live now.
    task.spawn(function()
        local bound
        while StealEngine.isCurrentGen() do
            local v = getDefendingXP()
            if v and v ~= bound then
                bound = v
                refreshXPLabel()
                v:GetPropertyChangedSignal("Value"):Connect(refreshXPLabel)
            end
            task.wait(2)
        end
    end)

    ParkFarm:AddLabel('Steal ONE time in a game first -- the Park has no', true)
    ParkFarm:AddLabel('fallback remote, so nothing fires until it is learned', true)

    ParkFarm:AddToggle('ParkAutoDefensive', { Text = 'Auto Defensive (Park)', Default = false, Callback = function(state)
        _G.ParkAutoDefensive = state
        if not state then
            stateLabel:SetText("Status: idle")
            return
        end

        task.spawn(function()
            local remote, isLearned = StealEngine.currentRemote()
            dprint(("PARK ON -- target %s, every %.2fs, remote %s"):format(
                StealEngine.TARGET_MODE, StealEngine.STEAL_INTERVAL,
                isLearned and ("learned (" .. remote.Name .. ")")
                    or "NOT learned yet -- steal once yourself in a game"))

            local pauseLogged = false
            while _G.ParkAutoDefensive and StealEngine.isCurrentGen() do
                if not isInGame() then
                    --  Paused, not stopped: the toggle stays on through the
                    --  plaza and picks straight back up when the next game
                    --  starts, so it does not have to be re-flipped each time.
                    if not pauseLogged then
                        stateLabel:SetText("Status: waiting for InGame")
                        dprint("paused -- Backpack.InGame is false")
                        pauseLogged = true
                    end
                    task.wait(0.5)
                else
                    if pauseLogged then
                        dprint("resumed -- InGame is true")
                        pauseLogged = false
                    end

                    local xp = getDefendingXP()
                    if DEFENDING_CAP > 0 and xp and xp.Value >= DEFENDING_CAP then
                        dprint(("stopping -- Defending/Rebounding XP reached %d"):format(DEFENDING_CAP))
                        _G.ParkAutoDefensive = false
                        pcall(function() Toggles.ParkAutoDefensive:SetValue(false) end)
                        break
                    end

                    stateLabel:SetText("Status: farming")
                    local ok, err = StealEngine.fireSteal()
                    if not ok and err then StealEngine.logFailure(err) end

                    task.wait(StealEngine.STEAL_INTERVAL)
                end
            end

            stateLabel:SetText("Status: idle")
            dprint("PARK OFF")
        end)
    end})

